# Copiá este archivo como .env.local y completá.

# --- Modelos ---
# Key de https://openrouter.ai/keys (da acceso a Claude, GPT, Gemini, Qwen y modelos :free)
OPENROUTER_API_KEY=
# Modelo seleccionado por defecto (cualquier id de lib/models.ts)
DEFAULT_MODEL=

# --- ARCA (opcional; sin esto las facturas quedan "Pendiente") ---
# ARCA_ENABLED=false            # apaga la verificación para toda la instalación
# Ver docs/arca-certificado.md
# ARCA_ENV=homologacion          # o produccion
# ARCA_CUIT=20123456789          # CUIT dueño del certificado
# ARCA_CERT_PATH=./certs/arca.crt
# ARCA_KEY_PATH=./certs/arca.key
# (alternativa para deploy: ARCA_CERT y ARCA_KEY con el contenido PEM, usando \n para los saltos)
